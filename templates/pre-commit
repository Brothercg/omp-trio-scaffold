#!/usr/bin/env bash
#
# TRIO 提交门禁 —— git pre-commit 兜底
#
# 与 .omp/hooks/pre/trio-guard.ts 共用同一套共享策略判定：
#   bin/trio-policy-eval.mjs → loadPolicy / decide / describeVerdict
# 两层职责分工：
#   - hook      ：实时拦截，阻止越权写入落盘
#   - pre-commit：提交前复核暂存区，防止绕过 hook 的路径（如手工 git add）
#
# 本 hook 承担两道检查：
#   1. 角色写权：暂存区路径必须落在当前角色的白名单内（策略见 policy.txt）
#   2. 报告合规：暂存的验收报告（docs/task/*/qa-*-report-*.md）必须通过
#      bin/trio-check-report.mjs 的机械校验（SKIP 不得计入通过等）
#
# 角色身份来自环境变量 TRIO_ROLE（arch / dev / qa）。
# 别名：'pm' 是 'arch' 的兼容别名，收到后自动归一化（旧环境变量不必改）。
# 未设置 TRIO_ROLE 时放行 —— 人工提交是合法逃生舱，本 hook 只做角色维度的校验。
#
# 用法：作为 .git/hooks/pre-commit 安装（由 bin/init-agent.sh 完成）。
#      也可手动运行：bash .git/hooks/pre-commit

set -uo pipefail

readonly POLICY_REL=".omp/trio/policy.txt"
readonly EXPECTED_GATE_VERSION=1
readonly SELF="$(basename "$0")"

log_error() { printf '%s: %s\n' "$SELF" "$*" >&2; }
log_info() { printf '%s: %s\n' "$SELF" "$*"; }

# ── 角色校验 ───────────────────────────────────────────────────────────────

GIT_DIR_PATH="$(git rev-parse --git-dir 2>/dev/null || true)"
readonly MARKER_REL="trio-last-gate-ok"

# TASK-007 §4.2：本 hook 真正跑完（放行）即写 marker，供 post-commit 区分
# 「正常提交」与「--no-verify 绕过」。仓库目录不可得时静默跳过。
write_gate_marker() {
	[[ -n "$GIT_DIR_PATH" ]] || return 0
	printf '%s\n' "$(date +%s)" >"${GIT_DIR_PATH}/${MARKER_REL}" 2>/dev/null || true
}

ROLE="${TRIO_ROLE:-}"
if [[ -z "$ROLE" ]]; then
	log_info "TRIO_ROLE 未设置 → 跳过角色校验（人工提交放行）"
	write_gate_marker
	exit 0
fi
# 归一化：兼容旧别名 pm → arch。
case "${ROLE,,}" in
	pm)
		ROLE="arch"
		log_info "TRIO_ROLE=pm 为兼容别名，按 arch 处理"
		;;
	arch | dev | qa) ROLE="${ROLE,,}" ;;
	*)
		log_error "TRIO_ROLE 取值非法：'${ROLE}'（应为 arch | dev | qa，兼容别名 pm）"
		exit 1
		;;
esac

# ── 定位项目根与暂存文件 ───────────────────────────────────────────────────
# 用 --show-toplevel 而非 $GIT_DIR/.. —— 在 linked worktree 中
# $GIT_DIR 是 <main>/.git/worktrees/<name>，反推会落到 .git/worktrees 上。
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
	log_error "不在 git 工作树中，跳过"
	exit 0
}
PROJECT_ROOT="$(cd "$PROJECT_ROOT" && pwd)"
POLICY_FILE="${PROJECT_ROOT}/${POLICY_REL}"

# BUG-2 / AC-5：严格解析 gate-version —— 必须恰好一行 ^# gate-version: <十进制整数>$。
# 缺行 / 重复 / 任一行非法（1.5、1abc、CRLF、缩进等）一律 fail-closed；三面同判。
check_gate_version() {
	local policy="$1" line digits count=0 value="" malformed="" saw=0
	if [[ ! -f "$policy" ]]; then
		log_error "执法件版本漂移：gate-version 声明缺失（policy 不可读）"
		return 1
	fi
	while IFS= read -r line || [[ -n "$line" ]]; do
		if [[ "$line" != "# gate-version:"* ]]; then continue; fi
		saw=1
		if [[ "$line" =~ ^"# gate-version: "([0-9]+)$ ]]; then
			digits="${BASH_REMATCH[1]}"
			if (( ${#digits} > 15 )); then
				malformed="$line"
				continue
			fi
			count=$((count + 1))
			value="$((10#$digits))"
		else
			malformed="$line"
		fi
	done <"$policy"
	if [[ -n "$malformed" ]]; then
		log_error "执法件版本漂移：gate-version 声明非法（${malformed}）"
		return 1
	fi
	if [[ "$saw" -eq 0 || "$count" -eq 0 ]]; then
		log_error "执法件版本漂移：gate-version 声明缺失"
		return 1
	fi
	if [[ "$count" -gt 1 ]]; then
		log_error "执法件版本漂移：gate-version 声明重复（必须恰好一行）"
		return 1
	fi
	if [[ "$value" != "$EXPECTED_GATE_VERSION" ]]; then
		log_error "执法件版本漂移：policy 声明 ${value} ≠ 执法件内嵌 ${EXPECTED_GATE_VERSION}"
		return 1
	fi
	return 0
}

STAGED="$(git diff --cached --name-only --diff-filter=ACMRDT 2>/dev/null)"

check_gate_version "$POLICY_FILE" || exit 1

# ── 共享策略判定器 ─────────────────────────────────────────────────────────
# 直接复用 guard 的 loadPolicy / decide / describeVerdict（单一实现，双面同裁决）。
# 模板位于 <repo>/templates/ 时从 ../bin 找；安装到 <repo>/.git/hooks/ 时从
# 项目根的 bin/ 找。找不到即 fail-closed，避免退回各写一套。

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EVALUATOR=""
for candidate in \
	"${SCRIPT_DIR}/../bin/trio-policy-eval.mjs" \
	"${PROJECT_ROOT}/bin/trio-policy-eval.mjs"; do
	if [[ -f "$candidate" ]]; then
		EVALUATOR="$candidate"
		break
	fi
done
if [[ -z "$EVALUATOR" ]]; then
	log_error "共享策略判定器缺失：bin/trio-policy-eval.mjs"
	log_error "拒绝提交（fail-closed）。重跑 bin/init-agent.sh 部署判定器。"
	exit 1
fi
if ! command -v bun >/dev/null 2>&1; then
	log_error "需要 bun 执行共享策略判定器，但 PATH 中找不到 bun"
	log_error "安装 bun，或用 git commit --no-verify 人工绕过（不推荐）。"
	exit 1
fi

if ! printf '%s\n' "$STAGED" | bun "$EVALUATOR" --policy "$POLICY_FILE" --role "$ROLE" --stdin; then
	log_error "TRIO 门禁：${ROLE} 的越权提交被拒绝"
	log_error "策略来源：${POLICY_REL}"
	log_error "若为误判，请修改 ${POLICY_REL} 后重试，或人工提交（git commit --no-verify）。"
	exit 1
fi

# ── 验收报告机械校验 ───────────────────────────────────────────────────────
# 暂存区出现 qa-*-report-*.md 时强制跑校验器：报告是「通过」判定的唯一凭据，
# 不允许未经机械校验的报告进入历史（SKIP 计入 PASS 等假绿由校验器拦截）。
# 清单（*-checklist-*）与其它文档不在本段管辖范围。

REPORTS=()
while IFS= read -r staged; do
	[[ -z "$staged" ]] && continue
	case "$staged" in
		docs/task/*/qa-*-report-*.md) REPORTS+=("$staged") ;;
	esac
done <<<"$STAGED"

if [[ ${#REPORTS[@]} -gt 0 ]]; then
	# trio 的运行前提就是 omp + bun（hook 本身是 TS）；缺失即环境不合法，fail-closed。
	if ! command -v bun >/dev/null 2>&1; then
		log_error "需要 bun 校验验收报告，但 PATH 中找不到 bun"
		log_error "安装 bun，或用 git commit --no-verify 人工绕过（不推荐）。"
		exit 1
	fi
	VALIDATOR="${PROJECT_ROOT}/bin/trio-check-report.mjs"
	if [[ ! -f "$VALIDATOR" ]]; then
		log_error "验收报告校验器缺失：bin/trio-check-report.mjs"
		log_error "重新运行 bin/init-agent.sh 部署校验器。"
		exit 1
	fi
	failed=0
	for report in "${REPORTS[@]}"; do
		if ! bun "$VALIDATOR" "${PROJECT_ROOT}/${report}" >/dev/null 2>&1; then
			log_error "验收报告不合规：${report}"
			bun "$VALIDATOR" "${PROJECT_ROOT}/${report}" >&2 || true
			failed=1
		fi
	done
	if [[ "$failed" -ne 0 ]]; then
		log_error "修复上述违规后重新 git add 该报告。"
		exit 1
	fi
fi

write_gate_marker
exit 0
